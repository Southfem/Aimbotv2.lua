local function nuke(container)
    if not container then return 0 end
    local n = 0
    for _, c in ipairs(container:GetChildren()) do
        if c:IsA("ScreenGui") then
            local nm = c.Name
            if nm:sub(1,3) == "ZHU" or nm:sub(1,4) == "TEST"
                or nm:find("Aimbot") or nm:find("ESP") or nm:find("Crosshair")
                or nm:find("Aim") or nm == "femboyhub" then
                c:Destroy()
                n = n + 1
            end
        end
    end
    return n
end

