-- ===== Rig tables =====
local R15 = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
}
local R6S = {{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}
local R6U = {{"Head","Torso"},{"Torso","LeftArm"},{"Torso","RightArm"},{"Torso","LeftLeg"},{"Torso","RightLeg"}}

local function toScr(v3)
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local sp, on = cam:WorldToViewportPoint(v3)
    if on then return Vector2.new(sp.X, sp.Y) end
end
local function partPos(ch, n)
    local p = ch:FindFirstChild(n)
    if p and p:IsA("BasePart") then return toScr(p.Position) end
end
local function drawSkel(ch, c, t)
    local bones = ch:FindFirstChild("UpperTorso") and R15
        or (ch:FindFirstChild("Left Arm") and R6S or R6U)
    for _, pr in ipairs(bones) do
        local a = partPos(ch, pr[1])
        local b = partPos(ch, pr[2])
        if a and b then drawL(a, b, t, c) end
    end
end
local function bounds(ch)
    local hrp = ch:FindFirstChild("HumanoidRootPart")
    local head = ch:FindFirstChild("Head")
    if not (hrp and head) then return end
    local hs = toScr(hrp.Position)
    if not hs then return end
    local hd = toScr(head.Position + Vector3.new(0, 0.5, 0))
    local ft = toScr(hrp.Position - Vector3.new(0, 3, 0))
    if not (hd and ft) then return end
    local h = math.abs(ft.Y - hd.Y)
    if h < 10 then return end
    local w = h * 0.55
    return Vector2.new(hs.X - w / 2, hd.Y), Vector2.new(hs.X + w / 2, ft.Y)
end
local function aimPart(ch)
    if aimMode == "Head" then
        local h = ch:FindFirstChild("Head")
        if h and h:IsA("BasePart") then return h end
    else
        local t = ch:FindFirstChild("UpperTorso") or ch:FindFirstChild("Torso")
        if t and t:IsA("BasePart") then return t end
    end
    return ch:FindFirstChild("HumanoidRootPart")
end

-- ===== Wall check =====
local wp = RaycastParams.new()
wp.FilterType = Enum.RaycastFilterType.Exclude
wp.IgnoreWater = true
local function los(from, tp)
    if not getWall() then return true end
    local f = {tp.Parent}
    if LP.Character then table.insert(f, LP.Character) end
    wp.FilterDescendantsInstances = f
    return workspace:Raycast(from, tp.Position - from, wp) == nil
end

-- ===== Team check =====
local function getTeamId(player)
    if player.Team then return "team:" .. player.Team.Name end
    local a1 = player:GetAttribute("Team")
    if a1 ~= nil then return "attr:" .. tostring(a1) end
    if player.Character then
        local a2 = player.Character:GetAttribute("Team")
        if a2 ~= nil then return "charattr:" .. tostring(a2) end
    end
    if player.TeamColor and player.TeamColor.Name ~= "White" then
        return "color:" .. player.TeamColor.Name
    end
    return nil
end
local function sameTeam(p)
    if not getTeam() then return false end
    local mine = getTeamId(LP)
    local theirs = getTeamId(p)
    return mine ~= nil and theirs ~= nil and mine == theirs
end

local function valid(p)
    if p == LP then return false end
    local c = p.Character
    if not c then return false end
    local h = c:FindFirstChildOfClass("Humanoid")
    if not h or h.Health <= 0 then return false end
    if getDeath() and h.Health <= 0 then return false end
    if sameTeam(p) then return false end
    return true
end

-- ===== Target selection =====
local function findTarget()
    local cam = workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    local mc = LP.Character
    local mh = mc and mc:FindFirstChild("HumanoidRootPart")
    local org = mh and mh.Position or cam.CFrame.Position
    local best, bd = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if valid(p) then
            local ch = p.Character
            local pt = aimPart(ch)
            if pt and (pt.Position - org).Magnitude <= CFG.MAX_DISTANCE then
                local sp, on = cam:WorldToViewportPoint(pt.Position)
                if on then
                    local dx, dy = sp.X - cx, sp.Y - cy
                    local d = math.sqrt(dx * dx + dy * dy)
                    if d <= currentFOV and d < bd and los(cam.CFrame.Position, pt) then
                        best, bd = p, d
                    end
                end
            end
        end
    end
    return best
end

-- ===== Aim =====
local function applyAim(pt)
    local cam = workspace.CurrentCamera
    if not cam then return 0 end
    local pos = pt.Position
    local off = 0
    if getPred() then
        local ch = pt.Parent
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local v = (hrp or pt).AssemblyLinearVelocity
        if v.Magnitude > CFG.MAX_VELOCITY then v = v.Unit * CFG.MAX_VELOCITY end
        local dist = (pos - cam.CFrame.Position).Magnitude
        local tt = math.min(dist / math.max(CFG.PROJECTILE_SPEED, 1), CFG.MAX_TRAVEL_TIME)
        local np = pos + v * tt
        off = (np - pos).Magnitude
        pos = np
    end
    local look = CFrame.lookAt(cam.CFrame.Position, pos)
    if lockMode == "Legit" then
        cam.CFrame = cam.CFrame:Lerp(look, CFG.SOFT_LOCK_ALPHA)
    else
        cam.CFrame = look
    end
    return off
end

local function teamColor(p)
    local t = p.Team
    if t then
        local tc = t.TeamColor
        if typeof(tc) == "BrickColor" then return tc.Color end
        if typeof(tc) == "Color3" then return tc end
    end
    return CFG.FALLBACK_COLOR
end

-- ===== Render loop =====
RunService:BindToRenderStep("ZHU_Main", Enum.RenderPriority.Camera.Value + 1, function()
    if _G.ZHU_SESSION ~= MY_SESSION then
        pcall(function() RunService:UnbindFromRenderStep("ZHU_Main") end)
        if gui then gui:Destroy() end
        return
    end

    local cam = workspace.CurrentCamera
    if not cam then return end

    resetL()

    local target = getAimbot() and findTarget() or nil
    local pt = target and target.Character and aimPart(target.Character) or nil

    if target and pt then
        local off = applyAim(pt)
        lockedPlr = target
        local predTxt = ""
        if getPred() and off > 0.05 then
            predTxt = string.format("  pred:+%.1f", off)
        end
        if lockMode == "Legit" then
            statusLbl.Text = " LEGIT  [" .. aimMode .. "]" .. predTxt
            statusLbl.TextColor3 = Color3.fromRGB(120, 180, 255)
        else
            statusLbl.Text = " BLATANT  [" .. aimMode .. "]" .. predTxt
            statusLbl.TextColor3 = CFG.LOCKED_COLOR
        end
    else
        lockedPlr = nil
        statusLbl.Text = getAimbot() and " SEARCHING" or " OFF"
        statusLbl.TextColor3 = getAimbot() and Color3.fromRGB(200, 200, 100) or Color3.fromRGB(180, 180, 180)
    end

    updateOverlay(lockedPlr ~= nil)

    if not getESP() then return end

    local mp = cam.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if valid(p) then
            local ch = p.Character
            local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - mp).Magnitude <= CFG.MAX_DISTANCE then
                local isL = (p == lockedPlr)
                local color = isL and CFG.LOCKED_COLOR or teamColor(p)
                local tl, br = bounds(ch)
                if tl and br then drawBox(tl, br, color, CFG.BOX_THICKNESS) end
                drawSkel(ch, color, CFG.SKEL_THICKNESS)
            end
        end
    end
end)

