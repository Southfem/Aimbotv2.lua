local lines = {}
local li = 1
local function getL()
    local l = lines[li]
    if not l then
        l = Instance.new("Frame")
        l.BorderSizePixel = 0
        l.ZIndex = 31
        l.Parent = dl
        lines[li] = l
    end
    li = li + 1
    return l
end
local function resetL()
    for _, l in ipairs(lines) do l.Visible = false end
    li = 1
end
local function drawL(a, b, t, c)
    local l = getL()
    local d = b - a
    local len = d.Magnitude
    if len < 1 then l.Visible = false return end
    l.Visible = true
    l.BackgroundColor3 = c
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Size = UDim2.fromOffset(len, t)
    l.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    l.Rotation = math.deg(math.atan2(d.Y, d.X))
end
local function drawBox(tl, br, c, t)
    drawL(tl, Vector2.new(br.X, tl.Y), t, c)
    drawL(Vector2.new(br.X, tl.Y), br, t, c)
    drawL(br, Vector2.new(tl.X, br.Y), t, c)
    drawL(Vector2.new(tl.X, br.Y), tl, t, c)
end

